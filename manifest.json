{
  "schemaVersion": 1,
  "id": "aimabe.mediajournal",
  "name": "Media Journal",
  "version": "0.4.1",
  "author": "aimen",
  "description": "Logs films/TV/books/games/comics/music with ratings + reviews as markdown notes in an Obsidian vault",
  "kinds": ["service", "menu", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "menu": "MediaMenu.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Media Journal",
    "description": "Toggles the media journal menu",
    "category": "Productivity",
    "defaultSection": "right",
    "allowMultiple": false
  }
}
